#!/sbin/openrc-run

description="Web UI pmOS Vince (port 80)"

command=/usr/bin/python3
command_args="/usr/libexec/vince-webui"
command_background=true
pidfile=/run/vince-webui.pid
output_log=/var/log/vince-webui.log
error_log=/var/log/vince-webui.log

depend() {
	need localmount
	use net
	after vince-setup networkmanager
}
