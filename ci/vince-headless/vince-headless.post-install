#!/bin/sh
# FIXED: `exit 0` dulu di baris atas membuat semua perintah di bawahnya
# (termasuk instalasi web UI & rc-update) tidak pernah dieksekusi.
addgroup pulse audio 2>/dev/null || true
addgroup pulse bluetooth 2>/dev/null || true

rc-update add vince-bluetooth default 2>/dev/null || true
rc-update add vince-audio default 2>/dev/null || true
rc-update add vince-webui default 2>/dev/null || true

# Web UI backend sudah dipasang oleh APKBUILD ke /var/www/localhost/htdocs.
# Fallback di bawah hanya untuk berjaga-jaga.
if [ -f /usr/share/vince/server.py ]; then
	mkdir -p /var/www/localhost/htdocs
	cp /usr/share/vince/server.py /var/www/localhost/htdocs/server.py 2>/dev/null || true
	cp /usr/share/vince/index.html /var/www/localhost/htdocs/index.html 2>/dev/null || true
fi

exit 0
