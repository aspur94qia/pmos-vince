#!/bin/sh
# Active Crossover Audio Routing (Dual Speaker Stereo Mod) MSM8953 (vince)

# 1. Reset Semua Sakelar Audio ALSA
amixer -c 0 sset 'EAR PA' 'OFF' 2>/dev/null || true
amixer -c 0 sset 'Ext Spk Switch' 'OFF' 2>/dev/null || true

# 2. Setup Kanal Kiri (Left) -> Earpiece (Khusus Treble Gemerincing & High Gain)
amixer -c 0 sset 'RX INT1 DEM MUX' 'CLSH' 2>/dev/null || true
amixer -c 0 sset 'RX INT1 MIX1 INP1' 'RX1' 2>/dev/null || true
amixer -c 0 sset 'EAR PA' 'ON' 2>/dev/null || true
amixer -c 0 sset 'RX1 Mix Digital Volume' 90% 2>/dev/null || true

# 3. Setup Kanal Kanan (Right) -> Loudspeaker Utama (Full-Range: Bass + Treble)
amixer -c 0 sset 'RX INT2 DEM MUX' 'CLSH' 2>/dev/null || true
amixer -c 0 sset 'RX INT2 MIX1 INP1' 'RX2' 2>/dev/null || true
amixer -c 0 sset 'Ext Spk Switch' 'ON' 2>/dev/null || true
amixer -c 0 sset 'RX2 Mix Digital Volume' 80% 2>/dev/null || true

# 4. Set Output Primary PulseAudio ke Stereo Analog Bawaan
pactl set-sink-volume alsa_output.platform-soc_sound.analog-stereo 85% 2>/dev/null || true
pactl set-default-sink alsa_output.platform-soc_sound.analog-stereo 2>/dev/null || true
