#!/usr/bin/python3
# Bluetooth receiver headless:
# - agen NoInputNoOutput (pairing tanpa kode/PIN)
# - semua perangkat otomatis dipercaya (trusted)
# - adapter selalu nyala, discoverable, pairable
import subprocess
import sys

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BLUEZ = "org.bluez"
AGENT_PATH = "/vince/agent"
ADAPTER = "/org/bluez/hci0"
try:
    NAME = open("/etc/vince/bt-name").read().strip()[:32] or "Vince Speaker"
except OSError:
    NAME = "Vince Speaker"

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def trust(device):
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, device),
                               "org.freedesktop.DBus.Properties")
        props.Set("org.bluez.Device1", "Trusted", dbus.Boolean(True))
    except Exception as e:
        log("trust gagal:", e)


class Agent(dbus.service.Object):
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        trust(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        trust(device)
        return "0000"

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        trust(device)
        return dbus.UInt32(0)

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        trust(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        trust(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        pass


agent = Agent(bus, AGENT_PATH)


def register():
    try:
        mgr = dbus.Interface(bus.get_object(BLUEZ, "/org/bluez"),
                             "org.bluez.AgentManager1")
        try:
            mgr.UnregisterAgent(AGENT_PATH)
        except dbus.DBusException:
            pass
        mgr.RegisterAgent(AGENT_PATH, "NoInputNoOutput")
        mgr.RequestDefaultAgent(AGENT_PATH)
        log("agent terdaftar")
        return True
    except dbus.DBusException as e:
        log("register gagal:", e)
        return False


def configure():
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, ADAPTER),
                               "org.freedesktop.DBus.Properties")
        for key, val in (
            ("Powered", dbus.Boolean(True)),
            ("Alias", dbus.String(NAME)),
            ("DiscoverableTimeout", dbus.UInt32(0)),
            ("PairableTimeout", dbus.UInt32(0)),
            ("Pairable", dbus.Boolean(True)),
            ("Discoverable", dbus.Boolean(True)),
        ):
            if props.Get("org.bluez.Adapter1", key) != val:
                props.Set("org.bluez.Adapter1", key, val)
    except dbus.DBusException as e:
        log("configure gagal:", e)


def trust_known():
    try:
        om = dbus.Interface(bus.get_object(BLUEZ, "/"),
                            "org.freedesktop.DBus.ObjectManager")
        for path, ifaces in om.GetManagedObjects().items():
            dev = ifaces.get("org.bluez.Device1")
            if dev and dev.get("Paired") and not dev.get("Trusted"):
                trust(path)
    except dbus.DBusException as e:
        log("trust_known gagal:", e)


def tick():
    configure()
    trust_known()
    return True


def on_owner_change(name, old, new):
    if new:
        log("bluetoothd (re)start")
        # ulangi tiap 2 detik sampai pendaftaran agent berhasil
        GLib.timeout_add_seconds(2, lambda: not register())


def start():
    if register():
        tick()
        GLib.timeout_add_seconds(10, tick)
        return False
    return True


try:
    subprocess.call(["rfkill", "unblock", "bluetooth"])
except OSError:
    pass

bus.add_signal_receiver(on_owner_change, "NameOwnerChanged",
                        "org.freedesktop.DBus", arg0=BLUEZ)
GLib.timeout_add_seconds(1, start)
GLib.MainLoop().run()
