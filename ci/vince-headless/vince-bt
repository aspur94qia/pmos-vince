#!/bin/sh
# Bluetooth receiver tanpa layar: satu sesi bluetoothctl menetap (agent default, discoverable terus)
BT_NAME="Vince Speaker"

i=0
until bluetoothctl list 2>/dev/null | grep -q "^Controller"; do
	i=$((i + 1))
	[ "$i" -gt 90 ] && exit 1
	sleep 2
done
rfkill unblock bluetooth 2>/dev/null

{
	sleep 2
	echo "power on"
	echo "system-alias $BT_NAME"
	echo "discoverable-timeout 0"
	echo "pairable-timeout 0"
	echo "agent NoInputNoOutput"
	echo "default-agent"
	echo "pairable on"
	echo "discoverable on"
	while true; do
		sleep 10
		echo "power on"
		echo "pairable on"
		echo "discoverable on"
	done
} | bluetoothctl >/dev/null 2>&1 &
BTPID=$!
trap 'kill $BTPID 2>/dev/null' EXIT TERM INT

while kill -0 "$BTPID" 2>/dev/null; do
	bluetoothctl devices 2>/dev/null | while read -r _ mac _; do
		[ -n "$mac" ] || continue
		bluetoothctl info "$mac" 2>/dev/null | grep -q "Trusted: yes" \
			|| bluetoothctl trust "$mac" >/dev/null 2>&1
	done
	sleep 10
done
exit 1
