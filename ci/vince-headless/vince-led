#!/bin/sh
# LED menyala terus saat charger tercolok / baterai mengisi,
# berkedip (heartbeat) saat memakai baterai.

charging() {
	for p in /sys/class/power_supply/*; do
		[ -d "$p" ] || continue
		type="$(cat "$p/type" 2>/dev/null)"
		case "$type" in
			Battery)
				case "$(cat "$p/status" 2>/dev/null)" in
					Charging|Full) return 0 ;;
				esac
				;;
			USB*|Mains)
				[ "$(cat "$p/online" 2>/dev/null)" = "1" ] && return 0
				;;
		esac
	done
	return 1
}

set_leds() {
	for led in /sys/class/leds/*; do
		[ -d "$led" ] || continue
		echo "$1" > "$led/trigger" 2>/dev/null
		max="$(cat "$led/max_brightness" 2>/dev/null || echo 255)"
		echo "$max" > "$led/brightness" 2>/dev/null
	done
}

state=""
while true; do
	if charging; then new=on; else new=off; fi
	if [ "$new" != "$state" ]; then
		if [ "$new" = on ]; then
			set_leds none
		else
			set_leds heartbeat
		fi
		state="$new"
	fi
	sleep 3
done
