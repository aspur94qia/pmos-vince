[connection]
id=Hotspot
uuid=c9398d5a-1b2c-4d3e-9f0a-123456789abc
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=10

[wifi]
mode=ap
band=bg
channel=6
ssid=pmOS-Vince

[wifi-security]
key-mgmt=wpa-psk
proto=rsn;
pairwise=ccmp;
group=ccmp;
psk=__HOTSPOT_PSK__

[ipv4]
method=shared

[ipv6]
method=ignore
