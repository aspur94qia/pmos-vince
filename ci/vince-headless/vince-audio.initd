#!/sbin/openrc-run

description="Routing audio: earpiece + speaker + EQ"

depend() {
	need vince-pulse
	after vince-bluetooth
}

start() {
	ebegin "Menyiapkan jalur audio vince"
	/usr/libexec/vince-audio start >/dev/null 2>&1
	eend 0
}

stop() {
	/usr/libexec/vince-audio stop >/dev/null 2>&1
	return 0
}
